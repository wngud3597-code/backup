# Copy names only into your local .env. Never commit actual credentials.
GMS_KEY=
GMS_CHAT_MODEL=gpt-4o-mini
# Optional per-role overrides. Empty values reuse GMS_CHAT_MODEL.
GMS_GENERATION_MODEL=
GMS_REVIEW_MODEL=
GMS_EMBEDDING_MODEL=text-embedding-3-small
MOVIES_DATA_PATH=data/movies.json
MOVIE_INDEX_PATH=data/runtime/chroma
DOCUMENT_INDEX_PATH=data/runtime/documents
DOCUMENT_CACHE_PATH=data/runtime/document_cache
MOVIE_SNAPSHOT_PATH=data/movie_snapshots.zip
DOCUMENT_CHUNK_SIZE=900
DOCUMENT_CHUNK_OVERLAP=120
# Real contact email or URL for live Wikimedia requests. Empty => snapshot fallback.
WIKI_CONTACT=
RAG_TOP_K=6
RAG_CONTEXT_CHARS=14000
RAG_MAX_PER_DOCUMENT=2
KOBIS_API_KEY=
